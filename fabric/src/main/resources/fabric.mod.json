{
	"schemaVersion": 1,
	"id": "decilib",
	"version": "${version}",
	"name": "deci-lib",
	"description": "High-fidelity data-driven combat mob library.",
	"authors": [
		"cleannrooster"
	],
	"contact": {},
	"license": "CC0-1.0",
